{
  "type": "record",
  "name": "AccountsMsg",
  "namespace": "com.eazybytes.avro",
  "doc": "Message sent when an account is created",
  "fields": [
    {"name": "accountNumber", "type": "long"},
    {"name": "name", "type": "string"},
    {"name": "email", "type": "string"},
    {"name": "mobileNumber", "type": "string"},
    {"name": "idempotencyKey", "type": "string", "doc": "Unique key for deduplication"}
  ]
}
